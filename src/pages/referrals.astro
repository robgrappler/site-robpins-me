---
// referrals.astro - Deals and gear directory styled with the editorial-band system.
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIndexLayer from "../components/SectionIndexLayer.astro";

const sectionMapItems = [
  { label: "TOOLS" },
  { label: "TECH" },
  { label: "INTERNET" },
  { label: "REWARDS" },
];

const referrals = [
  {
    kicker: "Terminal",
    title: "Warp Terminal",
    description: "The terminal for the 21st century. Fast, focused, and useful.",
    href: "https://app.warp.dev/referral/JXG89G",
    cta: "Get Deal",
  },
  {
    kicker: "Voice",
    title: "Wispr Flow",
    description: "Voice dictation that actually holds up. One month free.",
    href: "https://wisprflow.ai/r?ROBERT1335",
    cta: "Get Month",
  },
  {
    kicker: "Payments",
    title: "DiDi Credit Card",
    description: "Rewards and benefits through the DiDi card offer.",
    href: "https://d.didiglobal.com/ujPMw27?r=11&c=M2",
    cta: "Get Card",
  },
  {
    kicker: "Internet",
    title: "Starlink",
    description: "High-speed satellite internet with a free month of service.",
    href: "https://starlink.com/residential?referral=RC-496153-83402-12",
    cta: "Free Month",
  },
  {
    kicker: "AI",
    title: "Manus",
    description: "Invitation link with 500 free credits at registration.",
    href: "https://manus.im/invitation/V9NI70JFCRY4E",
    cta: "Get Credits",
  },
];
---

<BaseLayout title="Deals & Gear — Robgrappler">
  <div class="page-shell">
    <a class="page-backlink" href="/">Back to Matroom</a>

    <header class="page-header">
      <div class="page-eyebrow">Useful Links</div>
      <h1 class="page-title">Deals & Gear</h1>
      <p class="page-lead">
        Tools and offers worth keeping around. No clutter, no filler, no giant
        sponsor wall.
      </p>
    </header>

    <SectionIndexLayer items={sectionMapItems}>
      {referrals.map((item) => (
        <div class="content-band">
          <span class="panel-kicker">{item.kicker}</span>
          <h2 class="band-heading">{item.title}</h2>
          <p class="panel-copy" style="margin-top: 0.75rem;">{item.description}</p>
          <div class="inline-link-list" style="margin-top: 1.25rem;">
            <a
              href={item.href}
              target="_blank"
              rel="noreferrer noopener"
            >
              {item.cta}
            </a>
          </div>
        </div>
      ))}
    </SectionIndexLayer>
  </div>
</BaseLayout>
