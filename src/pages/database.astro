---
// database.astro - Upgraded archive index page that preserves the match collection and filter behavior.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import MatchCard from "../components/match-db/MatchCard.astro";
import MatchFilters from "../components/match-db/MatchFilters.astro";
import SearchBar from "../components/match-db/SearchBar.astro";
import SectionIndexLayer from "../components/SectionIndexLayer.astro";
import "../components/match-db/styles.css";
import { useTranslations } from "../i18n/ui";

const t = useTranslations("en");

const matches = await getCollection("matches");
const sortedMatches = matches.sort((a, b) =>
  b.data.uploadDate.localeCompare(a.data.uploadDate),
);
const sources = Array.from(
  new Set(sortedMatches.map((entry) => entry.data.source).filter(Boolean)),
).sort();
const years = Array.from(
  new Set(
    sortedMatches
      .map((entry) => entry.data.uploadDate?.slice(0, 4))
      .filter(Boolean),
  ),
).sort((a, b) => b.localeCompare(a));

const sectionMapItems = [
  { label: "MATCHES" },
  { label: "SESSIONS" },
  { label: "SERIES" },
  { label: "ARCHIVE" },
];
---

<BaseLayout title={t("db.title")} description={t("db.subtitle")}>
  <div class="match-db-page">
    <div class="page-shell">
      <div class="gateway-topbar" style="margin-bottom: 2rem;">
        <a class="page-backlink" href="/">Back</a>
        <LanguagePicker currentLang="en" />
      </div>

      <header class="page-header">
        <div class="page-eyebrow">Archive Index</div>
        <h1 class="page-title">{t("db.title")}</h1>
        <p class="page-lead">{t("db.subtitle")}</p>
      </header>

      <SectionIndexLayer items={sectionMapItems}>
        <div class="match-db-controls" style="margin-bottom: 1.5rem;">
          <SearchBar placeholder={t("db.searchPlaceholder")} />
          <MatchFilters
            sources={sources}
            years={years}
            total={sortedMatches.length}
          />
        </div>

        <section class="match-db-grid">
          {sortedMatches.map((entry) => <MatchCard entry={entry} lang="en" />)}
        </section>

        <div class="match-db-empty" data-match-empty hidden>
          {t("db.empty")}
        </div>
      </SectionIndexLayer>
    </div>
  </div>
</BaseLayout>
