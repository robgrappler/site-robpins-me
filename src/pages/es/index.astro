---
// es/index.astro - Spanish gateway. Same cinematic system as EN; all secondary links point to EN routes.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { featuredMatch } from "../../data/featured-match";
import LanguagePicker from "../../components/LanguagePicker.astro";

type LinkEntry = CollectionEntry<"links">;

// Reuse EN link entries — images and data are shared; only labels/subtitles are translated below.
const allLinks = (await getCollection("links")).filter((entry) =>
  entry.slug.startsWith("en/"),
);

const linkMap = new Map(allLinks.map((entry) => [entry.slug, entry]));

const getLink = (slug: string) => {
  const entry = linkMap.get(slug);
  if (!entry) throw new Error(`Missing link entry: ${slug}`);
  return entry;
};

const allMatches = await getCollection("matches");
const latestDbFeatured = allMatches
  .filter((m) => m.data.featured)
  .sort((a, b) => {
    const dateA = new Date(a.data.uploadDate || 0).getTime();
    const dateB = new Date(b.data.uploadDate || 0).getTime();
    return dateB - dateA;
  })[0];

const activeFeatured = latestDbFeatured
  ? {
      ...featuredMatch,
      title: latestDbFeatured.data.titleEs || latestDbFeatured.data.titleEn,
      subtitle: latestDbFeatured.data.descEs || latestDbFeatured.data.descEn,
      href: latestDbFeatured.data.href || `/database/${latestDbFeatured.slug}`,
      duration: latestDbFeatured.data.duration,
      thumb: latestDbFeatured.data.thumb,
    }
  : featuredMatch;

const navigationItems = [
  {
    label: "Empieza Aquí",
    href: "/start",
    image: getLink("en/01-start-here").data.image,
    external: false,
    subtitle: "Orientación",
  },
  {
    label: "YouTube",
    href: getLink("en/02-youtube").data.url,
    image: getLink("en/02-youtube").data.image,
    external: true,
    subtitle: "Biblioteca de Video",
  },
  {
    label: "Breakdown",
    href: "https://robgrappler.io/blog/?lang=en",
    image: getLink("en/03-newsletter").data.image,
    external: true,
    subtitle: "Notas Semanales",
  },
  {
    label: "Combate Destacado",
    href: activeFeatured.href,
    image: activeFeatured.thumb,
    external: activeFeatured.href.startsWith("http"),
    subtitle: "Ver Ahora",
  },
  {
    label: "Base de Datos",
    href: "/database",
    image: getLink("en/04-database").data.image,
    external: false,
    subtitle: "Archivo de Combates",
  },
  {
    label: "The Vault",
    href: getLink("en/07-vault").data.url,
    image: getLink("en/07-vault").data.image,
    external: true,
    subtitle: "Acceso Premium",
  },
  {
    label: "Redes Sociales",
    href: "#social-links",
    image: getLink("en/08-community").data.image,
    external: false,
    subtitle: "X • Instagram • Telegram",
  },
  {
    label: "Apoya",
    href: "/support",
    image: getLink("en/11-support").data.image,
    external: false,
    subtitle: "Mantener el Impulso",
  },
];

const socials = [
  getLink("en/05-twitter"),
  getLink("en/06-instagram"),
  getLink("en/08-community"),
  getLink("en/09-referrals"),
];
---

<BaseLayout
  title="Robgrappler | Sala de Mat Digital"
  description="El hub público para combates archivados, notas semanales, lanzamientos y las rutas más directas al ecosistema Robgrappler."
>
  <div class="gateway-page">
    <div class="gateway-backdrop" aria-hidden="true">
      <div
        class="gateway-backdrop-image"
        data-gateway-backdrop
        style={`background-image:url('${navigationItems[0].image}');`}
      >
      </div>
    </div>

    <div class="gateway-shell">
      <div class="gateway-topbar">
        <div class="gateway-lockup">Sala de Mat Digital v3.0</div>
        <LanguagePicker currentLang="es" />
      </div>

      <div class="gateway-layout">
        <section class="gateway-hero">
          <div class="page-eyebrow">Sistema de Archivo Robgrappler</div>
          <h1 class="gateway-brand">
            <span class="gateway-brand-mark">Robgrappler</span>
          </h1>
          <p class="gateway-intro">
            El hub público para combates archivados, notas afiladas, lanzamientos
            pagos y las rutas más limpias al resto del ecosistema.
          </p>

          <nav class="gateway-nav" aria-label="Destinos principales">
            {
              navigationItems.map(
                ({ label, href, image, external, subtitle }, index) => {
                  const isFeaturedRow = label === "Combate Destacado";
                  const navKind = external
                    ? "external"
                    : href.startsWith("#")
                      ? "anchor"
                      : "internal";

                  return (
                    <a
                      href={href}
                      target={external ? "_blank" : undefined}
                      rel={external ? "noreferrer noopener" : undefined}
                      class={`gateway-link ${index === 0 ? "is-active" : ""} ${isFeaturedRow ? "is-featured-spotlight" : ""}`}
                      data-gateway-item
                      data-bg={image}
                      data-nav-kind={navKind}
                    >
                      <span class="gateway-index">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <span class="gateway-title">{label}</span>
                      <span class="gateway-subtitle">{subtitle}</span>
                    </a>
                  );
                },
              )
            }
          </nav>

          <div class="inline-link-list" id="social-links">
            {
              socials.map((entry) => {
                const isExternal = entry.data.url.startsWith("http");
                return (
                  <a
                    href={entry.data.url}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noreferrer noopener" : undefined}
                  >
                    {entry.data.label}
                  </a>
                );
              })
            }
            <a href="/contact">Contacto</a>
          </div>

          <footer class="site-footer">
            © {new Date().getFullYear()} Robgrappler. Construido para la señal,
            no el ruido.
          </footer>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const initGatewayBackdrop = () => {
    const page = document.querySelector(".gateway-page");
    const nav = document.querySelector(".gateway-nav");
    const backdrop = document.querySelector("[data-gateway-backdrop]");
    const items = Array.from(document.querySelectorAll("[data-gateway-item]"));
    if (!page || !nav || !backdrop || !items.length) return;

    let handoffTimer;

    const setActive = (item, options = {}) => {
      const { force = false } = options;
      if (!item || (!force && nav.classList.contains("is-handoff"))) return;
      const image = item?.getAttribute("data-bg");
      if (image) backdrop.style.backgroundImage = `url('${image}')`;
      items.forEach((node) => node.classList.remove("is-active"));
      item?.classList.add("is-active");
    };

    const clearCommitState = () => {
      window.clearTimeout(handoffTimer);
      nav.classList.remove("is-handoff");
      page.classList.remove("is-handoff");
      items.forEach((node) => node.classList.remove("is-committing"));
    };

    const resetGatewayState = () => {
      clearCommitState();
      setActive(items[0], { force: true });
    };

    if (nav.dataset.gatewayBound === "true") {
      resetGatewayState();
      return;
    }

    nav.dataset.gatewayBound = "true";

    const isModifiedClick = (event) =>
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey;

    const beginHandoff = (item, href) => {
      if (!href) return;
      clearCommitState();
      setActive(item, { force: true });
      nav.classList.add("is-handoff");
      page.classList.add("is-handoff");
      item.classList.add("is-committing");
      handoffTimer = window.setTimeout(() => {
        window.location.assign(href);
      }, 240);
    };

    items.forEach((item) => {
      item.addEventListener("mouseenter", () => setActive(item));
      item.addEventListener("focus", () => setActive(item));
      item.addEventListener("click", (event) => {
        if (isModifiedClick(event)) return;
        const navKind = item.getAttribute("data-nav-kind");
        const href = item.getAttribute("href");
        if (navKind !== "internal" || !href) return;
        event.preventDefault();
        beginHandoff(item, href);
      });
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") resetGatewayState();
    });
  };

  initGatewayBackdrop();
  document.addEventListener("astro:after-swap", initGatewayBackdrop);
</script>
