---
// src/pages/es/support.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguagePicker from "../../components/LanguagePicker.astro";
import SectionIndexLayer from "../../components/SectionIndexLayer.astro";

const title = "Apoya al creador";
const description = "Apoyo voluntario para proyectos y trabajo continuo.";

const sectionMapItems = [
  { label: "LOCAL" },
  { label: "INTERNACIONAL" },
  { label: "DIRECTO" },
];

const supportOptions = [
  {
    kicker: "Local",
    title: "Mercado Pago (MX)",
    note: "Rápido, local y familiar.",
    links: [
      { text: "MXN $100", href: "https://mpago.la/1W5621s" },
      { text: "MXN $250", href: "https://mpago.la/2XRWng7" },
      { text: "MXN $500", href: "https://mpago.la/1sacJ4T" },
    ],
    otherLink: {
      url: "https://link.mercadopago.com.mx/robgraplr",
      label: "Otra cantidad",
    },
  },
  {
    kicker: "Internacional",
    title: "PayPal (Intl)",
    note: "Para apoyo internacional.",
    links: [
      { text: "$5 USD", href: "https://www.paypal.com/ncp/payment/RQG9F6ZWKG2G8" },
      { text: "$10 USD", href: "https://www.paypal.com/ncp/payment/3ATJDFHRZQPNY" },
      { text: "$25 USD", href: "https://www.paypal.com/ncp/payment/S6W7LBH2GQEHA" },
    ],
    otherLink: {
      url: "https://www.paypal.com/ncp/payment/PWTSTJSXV7CYY",
      label: "Otra cantidad",
    },
  },
  {
    kicker: "Directo",
    title: "Personalizado / Otro",
    note: "¿Prefieres otro método? Escríbeme.",
    links: [
      {
        text: "Contáctame",
        href: "mailto:rob@robgrappler.io?subject=Consulta%20de%20apoyo&body=Hola%20%E2%80%94%0A%0AMe%20gustar%C3%ADa%20preguntar%20sobre%20una%20forma%20alternativa%20de%20apoyo.",
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} image="/images/support-card.png">
  <div class="page-shell">
    <div class="gateway-topbar" style="margin-bottom: 2rem;">
      <a class="page-backlink" href="/es/">Volver</a>
      <LanguagePicker currentLang="es" />
    </div>

    <header class="page-header">
      <div class="page-eyebrow">Apoyo</div>
      <h1 class="page-title">{title}</h1>
      <p class="page-lead">
        Para quienes han preguntado cómo contribuir. Completamente opcional. 
        Limpio, directo y separado del flujo público de navegación.
      </p>
    </header>

    <SectionIndexLayer items={sectionMapItems}>
      {supportOptions.map((option) => (
        <div class="content-band">
          <span class="panel-kicker">{option.kicker}</span>
          <h2 class="band-heading">{option.title}</h2>
          <p class="panel-copy" style="margin-top: 0.75rem;">{option.note}</p>

          <div class="action-row" style="margin-top: 1.25rem;">
            {option.links.map((link) => (
              <a
                class="action-pill primary"
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer noopener" : undefined}
              >
                {link.text}
              </a>
            ))}
          </div>

          {option.otherLink && (
            <div class="inline-link-list">
              <a
                href={option.otherLink.url}
                target="_blank"
                rel="noreferrer noopener"
              >
                {option.otherLink.label}
              </a>
            </div>
          )}
        </div>
      ))}
    </SectionIndexLayer>
  </div>
</BaseLayout>
