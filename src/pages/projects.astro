---
// projects.astro — Systems page, editorial-band pattern
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIndexLayer from "../components/SectionIndexLayer.astro";
import { projects } from "../data/config";

const sectionMapItems = [
  { label: "PIPELINE" },
  { label: "MATCH DB" },
];
---

<BaseLayout title="Systems — Robgrappler">
  <div class="page-shell">
    <a class="page-backlink" href="/">Back to Matroom</a>

    <header class="page-header">
      <div class="page-eyebrow">Systems</div>
      <h1 class="page-title">Active Work</h1>
      <p class="page-lead">
        Tools and infrastructure running behind Robgrappler content and
        operations.
      </p>
    </header>

    <SectionIndexLayer items={sectionMapItems}>
      {
        projects.map((project) => (
          <div class="content-band">
            {project.status && (
              <span class="panel-kicker">{project.status}</span>
            )}
            <h2 class="band-heading">{project.title}</h2>
            <p class="panel-copy" style="margin-top: 0.75rem;">
              {project.description}
            </p>
            {project.href && (
              <div class="inline-link-list" style="margin-top: 1.25rem;">
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View on GitHub
                </a>
              </div>
            )}
          </div>
        ))
      }
    </SectionIndexLayer>
  </div>
</BaseLayout>
