---
// support.astro - Support page redesigned to match the upgraded cinematic visual system.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
import SectionIndexLayer from "../components/SectionIndexLayer.astro";

const title = "Support the work";
const description = "Optional support for ongoing work and projects.";

const sectionMapItems = [
  { label: "LOCAL" },
  { label: "INTERNATIONAL" },
  { label: "DIRECT" },
];

const supportOptions = [
  {
    kicker: "Local",
    title: "Mercado Pago (MX)",
    note: "Fast, local, and familiar.",
    links: [
      { text: "MXN $100", href: "https://mpago.la/1W5621s" },
      { text: "MXN $250", href: "https://mpago.la/2XRWng7" },
      { text: "MXN $500", href: "https://mpago.la/1sacJ4T" },
    ],
    otherLink: {
      url: "https://link.mercadopago.com.mx/robgraplr",
      label: "Other amount",
    },
  },
  {
    kicker: "International",
    title: "PayPal (Intl)",
    note: "For international support.",
    links: [
      { text: "$5 USD", href: "https://www.paypal.com/ncp/payment/RQG9F6ZWKG2G8" },
      { text: "$10 USD", href: "https://www.paypal.com/ncp/payment/3ATJDFHRZQPNY" },
      { text: "$25 USD", href: "https://www.paypal.com/ncp/payment/S6W7LBH2GQEHA" },
    ],
    otherLink: {
      url: "https://www.paypal.com/ncp/payment/PWTSTJSXV7CYY",
      label: "Other amount",
    },
  },
  {
    kicker: "Direct",
    title: "Custom / Other",
    note: "Prefer another method? Reach out directly.",
    links: [
      {
        text: "Reach out",
        href: "mailto:rob@robgrappler.io?subject=Support%20inquiry&body=Hi%20%E2%80%94%0A%0AI%E2%80%99d%20like%20to%20ask%20about%20an%20alternative%20way%20to%20support.",
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} image="/images/support-card.png">
  <div class="page-shell">
    <div class="gateway-topbar" style="margin-bottom: 2rem;">
      <a class="page-backlink" href="/">Back</a>
      <LanguagePicker currentLang="en" />
    </div>

    <header class="page-header">
      <div class="page-eyebrow">Support</div>
      <h1 class="page-title">{title}</h1>
      <p class="page-lead">
        For the people who asked how to contribute. Completely optional. Clean,
        direct, and kept separate from the public browsing flow.
      </p>
    </header>

    <SectionIndexLayer items={sectionMapItems}>
      {supportOptions.map((option) => (
        <div class="content-band">
          <span class="panel-kicker">{option.kicker}</span>
          <h2 class="band-heading">{option.title}</h2>
          <p class="panel-copy" style="margin-top: 0.75rem;">{option.note}</p>

          <div class="action-row" style="margin-top: 1.25rem;">
            {option.links.map((link) => (
              <a
                class="action-pill primary"
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer noopener" : undefined}
              >
                {link.text}
              </a>
            ))}
          </div>

          {option.otherLink && (
            <div class="inline-link-list">
              <a
                href={option.otherLink.url}
                target="_blank"
                rel="noreferrer noopener"
              >
                {option.otherLink.label}
              </a>
            </div>
          )}
        </div>
      ))}
    </SectionIndexLayer>
  </div>
</BaseLayout>
