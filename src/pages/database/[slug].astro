---
// [slug].astro - Match detail page kept data-compatible while adopting the new archive visual language.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import VideoPlayer from "../../components/match-db/VideoPlayer.astro";
import "../../components/match-db/styles.css";

export async function getStaticPaths() {
  const matches = await getCollection("matches");
  return matches.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const displayDate = data.uploadDate
  ? new Date(data.uploadDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "2-digit",
    })
  : "";
const thumbStyle = data.thumb
  ? `--match-db-thumb: url('${data.thumb}')`
  : undefined;
---

<BaseLayout title={`${data.titleEn} — Match DB`} description={data.descEn}>
  <div class="match-db-page">
    <div class="page-shell">
      <a class="page-backlink" href="/database">Back to Database</a>

      <header class="page-header" style="margin-bottom: 2rem;">
        <div class="page-eyebrow">Archive Detail</div>
        <h1 class="page-title">{data.titleEn}</h1>
        <p class="page-lead">{data.descEn}</p>
      </header>

      <div class="match-db-detail">
        <section class="match-db-detail-card">
          {
            data.trailerUrl ? (
              <VideoPlayer url={data.trailerUrl} poster={data.trailerPoster} />
            ) : (
              <div
                class="match-db-thumb match-db-thumb-large"
                style={thumbStyle}
              />
            )
          }

          <div class="match-db-detail-body">
            <span class="match-db-eyebrow">{data.source}</span>
            <div class="match-db-meta">
              <span>{displayDate}</span>
              <span>{data.duration}</span>
            </div>
            {
              data.tags && data.tags.length > 0 && (
                <div class="match-db-tag-row">
                  {data.tags.map((tag) => <span class="match-db-chip">{tag.en}</span>)}
                </div>
              )
            }
            <div class="match-db-detail-actions">
              {
                data.href && (
                  <a
                    class="match-db-button primary"
                    href={data.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View Source
                  </a>
                )
              }
              <a class="match-db-button" href="/database">Back to DB</a>
            </div>
          </div>
        </section>

        <section class="match-db-detail-card">
          <div class="match-db-detail-body">
            <span class="match-db-eyebrow">Notes</span>
            <div class="match-db-richtext">
              <Content />
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
