---
// start.astro - Editorial orientation page for the upgraded homepage entry flow.
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIndexLayer from "../components/SectionIndexLayer.astro";

const sectionMapItems = [
  { label: "WATCH" },
  { label: "SEARCH" },
  { label: "READ" },
  { label: "SUPPORT" },
];
---

<BaseLayout title="Start Here — Robgrappler">
  <div class="page-shell">
    <div class="gateway-topbar" style="margin-bottom: 2rem;">
      <a class="page-backlink" href="/">Back</a>
      <LanguagePicker currentLang="en" />
    </div>

    <header class="page-header">
      <div class="page-eyebrow">Orientation</div>
      <h1 class="page-title">Start Here</h1>
      <p class="page-lead">
        The shortest path into the archive: start with the strongest public
        videos, jump into the database when you want depth, or subscribe to get
        release notes without noise.
      </p>
    </header>

    <SectionIndexLayer items={sectionMapItems}>
      <div class="content-band">
        <span class="panel-kicker">Watch First</span>
        <h2 class="band-heading">YouTube Essentials</h2>
        <p class="panel-copy" style="margin-top: 0.75rem;">
          Best entry point for standout sessions, public highlights, and the
          cleanest way to understand the style before diving deeper.
        </p>
        <div style="margin-top: 1.25rem;">
          <a
            class="action-pill primary"
            href="https://www.youtube.com/watch?v=lbEeaQPBSz8&list=PL56CIGann90HWS1aKWsE_1QG4B-PJ4-pC&autoplay=1&mute=1"
            target="_blank"
            rel="noreferrer noopener"
          >
            Watch Playlist
          </a>
        </div>
      </div>

      <div class="content-band">
        <span class="panel-kicker">Go Deeper</span>
        <h2 class="band-heading">Database</h2>
        <p class="panel-copy" style="margin-top: 0.75rem;">
          Search the archive by title, source, and year when you want actual
          breadth instead of a curated surface.
        </p>
        <div class="inline-link-list" style="margin-top: 1.25rem;">
          <a href="/database">Open Database</a>
        </div>
      </div>

      <div class="content-band">
        <span class="panel-kicker">Stay Synced</span>
        <h2 class="band-heading">Breakdown</h2>
        <p class="panel-copy" style="margin-top: 0.75rem;">
          Weekly notes on grappling systems, release timing, and the workflows
          behind the machine.
        </p>
        <div class="inline-link-list" style="margin-top: 1.25rem;">
          <a href="/breakdown">Read the Notes</a>
          <a href="/support">Support the Work</a>
        </div>
      </div>
    </SectionIndexLayer>
  </div>
</BaseLayout>
