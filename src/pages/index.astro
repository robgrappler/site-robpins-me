---
// index.astro - Cinematic gateway homepage that maps the existing content routes into the upgraded visual system.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { featuredMatch } from "../data/featured-match";
import LanguagePicker from "../components/LanguagePicker.astro";

type LinkEntry = CollectionEntry<"links">;

const allLinks = (await getCollection("links")).filter((entry) =>
  entry.slug.startsWith("en/"),
);

const linkMap = new Map(allLinks.map((entry) => [entry.slug, entry]));

const getLink = (slug: string) => {
  const entry = linkMap.get(slug);
  if (!entry) {
    throw new Error(`Missing homepage link entry for slug: ${slug}`);
  }
  return entry;
};

const allMatches = await getCollection("matches");
const latestDbFeatured = allMatches
  .filter((m) => m.data.featured)
  .sort((a, b) => {
    const dateA = new Date(a.data.uploadDate || 0).getTime();
    const dateB = new Date(b.data.uploadDate || 0).getTime();
    return dateB - dateA;
  })[0];

const activeFeatured = latestDbFeatured
  ? {
      ...featuredMatch,
      title: latestDbFeatured.data.titleEn,
      subtitle: latestDbFeatured.data.descEn,
      href: latestDbFeatured.data.href || `/database/${latestDbFeatured.slug}`,
      duration: latestDbFeatured.data.duration,
      thumb: latestDbFeatured.data.thumb,
    }
  : featuredMatch;

const navigationItems = [
  {
    label: getLink("en/01-start-here").data.label,
    href: getLink("en/01-start-here").data.url,
    image: getLink("en/01-start-here").data.image,
    external: false,
    subtitle: "Orientation",
  },
  {
    label: "The Inner Circle",
    href: getLink("en/10-vip").data.url,
    image: getLink("en/10-vip").data.image,
    external: true,
    subtitle: "Rob's Corner on Telegram",
    vip: true,
  },
  {
    label: getLink("en/02-youtube").data.label,
    href: getLink("en/02-youtube").data.url,
    image: getLink("en/02-youtube").data.image,
    external: true,
    subtitle: "Video Library",
  },
  {
    label: getLink("en/03-newsletter").data.label,
    href: getLink("en/03-newsletter").data.url,
    image: getLink("en/03-newsletter").data.image,
    external: false,
    subtitle: "Weekly Notes",
  },
  {
    label: "Featured Match",
    href: activeFeatured.href,
    image: activeFeatured.thumb,
    external: activeFeatured.href.startsWith("http"),
    subtitle: "Watch Now",
  },
  {
    label: getLink("en/04-database").data.label,
    href: getLink("en/04-database").data.url,
    image: getLink("en/04-database").data.image,
    external: false,
    subtitle: "Match Archive",
  },
  {
    label: getLink("en/07-vault").data.label,
    href: getLink("en/07-vault").data.url,
    image: getLink("en/07-vault").data.image,
    external: true,
    subtitle: "Premium Access",
  },
  {
    label: "Socials",
    href: "/socials",
    image: getLink("en/08-community").data.image,
    external: false,
    subtitle: "X • YT • IG • TikTok • TG",
  },
  {
    label: getLink("en/11-support").data.label,
    href: getLink("en/11-support").data.url,
    image: getLink("en/11-support").data.image,
    external: false,
    subtitle: "Keep It Moving",
  },
];

const socials = [
  getLink("en/05-twitter"),
  getLink("en/06-instagram"),
  getLink("en/08-community"),
  getLink("en/09-referrals"),
];
---

<BaseLayout
  title="Robgrappler | Digital Matroom"
  description="A cinematic hub for match archives, breakdowns, support, and the cleanest path into Robgrappler's world."
>
  <div class="gateway-page">
    <div class="gateway-backdrop" aria-hidden="true">
      <div
        class="gateway-backdrop-image"
        data-gateway-backdrop
        style={`background-image:url('${navigationItems[0].image}');`}
      >
      </div>
    </div>

    <div class="gateway-shell">
      <div class="gateway-topbar">
        <div class="gateway-lockup">Digital Matroom v3.0</div>
        <LanguagePicker currentLang="en" />
      </div>

      <div class="gateway-layout">
        <section class="gateway-hero">
          <div class="gateway-header">
            <h1 class="gateway-brand"><span class="gateway-brand-mark">Robgrappler</span></h1>
            <p class="gateway-intro">
              Matches. Breakdowns. The full ecosystem.
            </p>
          </div>

          <div class="gateway-scroll-area">
            <nav class="gateway-nav" aria-label="Primary destinations">
              {
                navigationItems.map(({ label, href, image, external, subtitle, vip }, index) => {
                  const isFeaturedRow = label === "Featured Match";
                  const isVipRow = vip === true;
                  const navKind = external ? "external" : href.startsWith("#") ? "anchor" : "internal";

                  return (
                    <a
                      href={href}
                      target={external ? "_blank" : undefined}
                      rel={external ? "noreferrer noopener" : undefined}
                      class={`gateway-link ${index === 0 ? "is-active" : ""} ${isFeaturedRow ? "is-featured-spotlight" : ""} ${isVipRow ? "is-vip-highlight" : ""}`}
                      data-gateway-item
                      data-bg={image}
                      data-nav-kind={navKind}
                    >
                      <span class="gateway-index">{String(index + 1).padStart(2, "0")}</span>
                      <span class="gateway-title">{label}</span>
                      <span class="gateway-subtitle">{subtitle}</span>
                    </a>
                  );
                })
              }
            </nav>

            <footer class="site-footer">
              © {new Date().getFullYear()} Robgrappler · Site submitted by <a href="https://nodoalfa.com" target="_blank" rel="noreferrer noopener" class="nodo-alfa-link">Nodo Alfa</a>.
            </footer>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const initGatewayBackdrop = () => {
    const page = document.querySelector(".gateway-page");
    const nav = document.querySelector(".gateway-nav");
    const backdrop = document.querySelector("[data-gateway-backdrop]");
    const items = Array.from(document.querySelectorAll("[data-gateway-item]"));
    if (!page || !nav || !backdrop || !items.length) return;

    let handoffTimer;

    const setActive = (item, options = {}) => {
      const { force = false } = options;
      if (!item || (!force && nav.classList.contains("is-handoff"))) {
        return;
      }

      const image = item?.getAttribute("data-bg");
      if (image) {
        backdrop.style.backgroundImage = `url('${image}')`;
      }

      items.forEach((node) => node.classList.remove("is-active"));
      item?.classList.add("is-active");
    };

    const clearCommitState = () => {
      window.clearTimeout(handoffTimer);
      nav.classList.remove("is-handoff");
      page.classList.remove("is-handoff");
      items.forEach((node) => node.classList.remove("is-committing"));
    };

    const resetGatewayState = () => {
      clearCommitState();
      setActive(items[0], { force: true });
    };

    // Scroll-collapse: add .is-scrolled when user scrolls down, remove only at top
    const scrollArea = document.querySelector(".gateway-scroll-area");
    if (scrollArea && !scrollArea.dataset.scrollBound) {
      scrollArea.dataset.scrollBound = "true";
      let ticking = false;
      scrollArea.addEventListener("scroll", () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            if (scrollArea.scrollTop > 16) {
              page.classList.add("is-scrolled");
            } else if (scrollArea.scrollTop === 0) {
              page.classList.remove("is-scrolled");
            }
            ticking = false;
          });
          ticking = true;
        }
      });
    }

    if (nav.dataset.gatewayBound === "true") {
      resetGatewayState();
      return;
    }

    nav.dataset.gatewayBound = "true";

    const isModifiedClick = (event) =>
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey;

    const beginHandoff = (item) => {
      clearCommitState();
      setActive(item, { force: true });

      nav.classList.add("is-handoff");
      page.classList.add("is-handoff");
      item.classList.add("is-committing");
    };

    items.forEach((item) => {
      item.addEventListener("mouseenter", () => setActive(item));
      item.addEventListener("focus", () => setActive(item));
      item.addEventListener("click", (event) => {
        if (isModifiedClick(event)) return;

        const navKind = item.getAttribute("data-nav-kind");
        if (navKind !== "internal") {
          return;
        }

        // Just trigger animation, let native navigation handle the link
        beginHandoff(item);
      });
    });

    window.addEventListener("pageshow", resetGatewayState);
    window.addEventListener("pagehide", clearCommitState);

    resetGatewayState();
  };

  initGatewayBackdrop();
  document.addEventListener("astro:after-swap", () => {
    initGatewayBackdrop();
  });
</script>
