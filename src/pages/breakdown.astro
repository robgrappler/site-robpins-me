---
// breakdown.astro - Newsletter landing page styled to match the cinematic site refresh.
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import SectionIndexLayer from "../components/SectionIndexLayer.astro";

const sectionMapItems = [
  { label: "WEEKLY NOTE" },
  { label: "ARCHIVE" },
  { label: "TRAINING" },
  { label: "WORKFLOW" },
];
---

<BaseLayout title="Breakdown — Robgrappler">
  <div class="page-shell">
    <a class="page-backlink" href="/">Back to Matroom</a>

    <header class="page-header">
      <div class="page-eyebrow">Newsletter</div>
      <h1 class="page-title">Breakdown</h1>
      <p class="page-lead">
        Short, useful notes on grappling systems, release timing, archive drops,
        and the occasional workflow that actually earned a place here.
      </p>
    </header>

    <SectionIndexLayer items={sectionMapItems}>
      <div class="content-band">
        <span class="panel-kicker">Signal Only</span>
        <h2 class="band-heading">Get the Weekly Note</h2>
        <p class="panel-copy" style="margin-top: 0.75rem;">
          No bloated funnel. No filler cadence. Just release-adjacent notes,
          match context, and the systems worth sharing.
        </p>
        <div style="margin-top: 1.25rem; max-width: 30rem;">
          <NewsletterForm id="main-form" />
        </div>
      </div>

      <div class="content-band">
        <span class="panel-kicker">What Lands</span>
        <ul class="bullet-list" style="margin-top: 1rem;">
          <li>Archive updates when featured or notable matches drop.</li>
          <li>Training and grappling notes with actual structure.</li>
          <li>Occasional tech and workflow experiments behind the scenes.</li>
        </ul>
      </div>

      <div class="inline-link-list" style="margin-top: 2rem;">
        <a href="/database">Browse Database</a>
        <a href="/start">Start Here</a>
      </div>
    </SectionIndexLayer>
  </div>
</BaseLayout>
