---
// success.astro - Newsletter signup confirmation using the shared page-shell system.
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
---

<BaseLayout title="Confirmed — Robgrappler">
  <div class="page-shell">
    <div class="gateway-topbar" style="margin-bottom: 2rem;">
      <a class="page-backlink" href="/">Back</a>
      <LanguagePicker currentLang="en" />
    </div>

    <header class="page-header">
      <div class="page-eyebrow">Confirmed</div>
      <h1 class="page-title">You're In</h1>
      <p class="page-lead">
        Thanks for subscribing. You've been added to the list.
      </p>
    </header>

    <div class="inline-link-list">
      <a href="/">Return to Matroom</a>
    </div>
  </div>
</BaseLayout>
